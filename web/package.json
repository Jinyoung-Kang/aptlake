{
  "name": "aptlake-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome lint src && node scripts/contrast.mjs",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "check:contrast": "node scripts/contrast.mjs --table"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "5.0.3"
  }
}
