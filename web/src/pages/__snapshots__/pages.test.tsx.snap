exports[`화면 특성 (서버 골든 응답으로 그린 결과) > 가격지수 > dom 1`] = `"<header class="header"><div class="topbar"><a class="brand" href="#/market" aria-label="AptLake 아파트 실거래 데이터 · 홈"><span class="mark" aria-hidden="true"></span>AptLake<span class="sub">아파트 실거래 데이터</span></a><search class="search" role="search"><span class="glass" aria-hidden="true">⌕</span><input placeholder="시군구·단지명 검색 (예: 분당, ㅂㄷ, 래미안)" aria-label="시군구·단지 검색" role="combobox" aria-expanded="false" aria-controls="search-results" value=""></search><div class="right"><span class="meta-chip" title="데이터셋 버전 · 원천 관측 시각">gold@test.1 · 원천 –</span><button type="button" class="icon-btn theme-btn" aria-label="화면 테마: OS 설정 따름 (지금 밝게) — 누르면 어둡게" title="화면 테마: OS 설정 따름 (지금 밝게) — 누르면 어둡게"><span aria-hidden="true">◐</span><span class="theme-name">자동</span></button></div></div><nav class="nav" aria-label="메뉴"><div class="nav-inner"><a href="#/market">시장 개요</a><a href="#/region">지역 분석</a><a href="#/trades">거래 목록</a><a href="#/index" aria-current="page">가격지수</a><a href="#/quality">데이터 품질</a><a href="#/dev">개발자</a><a href="#/ops">수집 상태</a></div></nav><section class="ticker" aria-label="주요 지표" aria-busy="false"><section class="ticker-inner" tabindex="0" aria-label="시장 지표 띠 (좌우 스크롤)"><div class="tick" title="전월 대비"><span class="l">전국 거래 2024.12</span><span class="v">1,070</span><span class="chg up"><span aria-hidden="true">▲ +0.9%</span><span class="sr-only">상승 0.9%</span></span></div><div class="tick" title="전년 동월 대비"><span class="l">전국 <span class="sqm">m<sup>2</sup></span>당 중위가</span><span class="v">1,512만원/<span class="sqm">m<sup>2</sup></span></span></div><div class="tick"><span class="l">해제율</span><span class="v">4.5%</span></div><div class="tick" title="전월 대비 (확정 월)"><span class="l">전국 지수 2024.12</span><span class="v">123.0</span><span class="chg up"><span aria-hidden="true">▲ +0.82%</span><span class="sr-only">상승 0.82%</span></span></div></section></section></header><main class="container"><div class="page-head"><div><div class="crumb">가격지수 · 자체 산출 실험 지수 (공식 통계 아님)</div><h1>전국 아파트 가격지수</h1></div></div><fieldset class="group chips mb-14"><legend class="sr-only">지역</legend><button type="button" class="chip" aria-pressed="true">전국</button></fieldset><div style="margin-bottom: 14px;"><div class="quote"><span class="price">123.00</span><span class="chg"><span class="chg up" title="전월 대비"><span aria-hidden="true">▲ +0.82%</span><span class="sr-only">상승 0.82%</span></span></span><span class="muted small">전월 대비</span><span class="chg"><span class="chg up" title="전년 같은 달 대비"><span aria-hidden="true">▲ +10.81%</span><span class="sr-only">상승 10.81%</span></span></span><span class="muted small">전년 대비</span></div><div class="quote-sub">2024.12 기준 (확정된 최근 달) · 2023-01=100 · HEDONIC_TD_v1</div></div><div class="layout" data-stale="false" aria-busy="false"><section class="section"><div class="section-head"><h2>자체 지수 vs R-ONE</h2><span class="sub">두 지수를 2023.01=100 으로 맞춤 · 음영 = 95% 신뢰구간</span><div class="tools"><fieldset class="group seg"><legend class="sr-only">기간</legend><button type="button" aria-pressed="false">1년</button><button type="button" aria-pressed="false">2년</button><button type="button" aria-pressed="false">3년</button><button type="button" aria-pressed="true">전체</button></fieldset></div></div><div class="panel panel-pad"><pre data-chart="자체 가격지수와 R-ONE 지수 비교">{"backgroundColor":"transparent","animationDuration":300,"textStyle":{"fontFamily":"","color":"","fontSize":12},"grid":{"left":8,"right":16,"top":28,"bottom":8,"containLabel":true},"tooltip":{"trigger":"axis","confine":true,"backgroundColor":"","borderColor":"","borderWidth":1,"padding":[8,10],"textStyle":{"color":"","fontSize":12},"extraCssText":"box-shadow: 0 6px 20px rgba(0,0,0,.12);","axisPointer":{"type":"line","lineStyle":{"color":""}}},"legend":{"top":0,"right":0,"itemWidth":12,"itemHeight":8,"icon":"roundRect","textStyle":{"color":"","fontSize":12},"data":["자체 지수 HEDONIC_TD_v1","95% 신뢰구간","R-ONE 매매지수(아파트)"]},"xAxis":{"axisLine":{"lineStyle":{"color":""}},"axisTick":{"show":false},"axisLabel":{"color":"","fontSize":11},"splitLine":{"show":false},"type":"category","data":["2023-01","2023-02","2023-03","2023-04","2023-05","2023-06","2023-07","2023-08","2023-09","2023-10","2023-11","2023-12","2024-01","2024-02","2024-03","2024-04","2024-05","2024-06","2024-07","2024-08","2024-09","2024-10","2024-11","2024-12"],"boundaryGap":false},"yAxis":{"axisLine":{"show":false},"axisTick":{"show":false},"axisLabel":{"color":"","fontSize":11},"splitLine":{"lineStyle":{"color":""}},"nameTextStyle":{"color":"","fontSize":11},"type":"value","scale":true,"name":"2023.01 = 100"},"series":[{"name":"ci","type":"line","stack":"ci","data":[99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122],"symbol":"none","lineStyle":{"opacity":0},"tooltip":{"show":false},"silent":true},{"name":"95% 신뢰구간","type":"line","stack":"ci","data":[2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2],"symbol":"none","lineStyle":{"opacity":0},"areaStyle":{"color":""},"itemStyle":{"color":""}},{"name":"자체 지수 HEDONIC_TD_v1","type":"line","data":[100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123],"symbol":"none","lineStyle":{"width":2,"color":""},"itemStyle":{"color":""},"markArea":{"silent":true,"itemStyle":{"color":"","opacity":0.6},"label":{"show":true,"color":"","fontSize":11,"position":"insideTop"},"data":[]}},{"name":"R-ONE 매매지수(아파트)","type":"line","data":[100,100.53,101.05,101.58,102.11,102.63,103.16,103.68,104.21,104.74,105.26,105.79,106.32,106.84,107.37,107.89,108.42,108.95,109.47,110,110.53,111.05,111.58,112.11],"symbol":"none","lineStyle":{"width":2,"color":""},"itemStyle":{"color":""}}]}</pre></div><details class="note" style="margin-top: 10px;"><summary style="cursor: pointer; color: var(--text-2);">산출 방법</summary><p>log(<span class="sqm">m<sup>2</sup></span>당 가격) = 단지 고정효과 + 월 더미 + 층 구간 + 면적 구간 + 오차. 월 계수를 지수로 바꿉니다(첫 달 = 100). 같은 단지 안의 가격 변화로 월 효과를 추정하므로, 비싼 단지 거래가 특정 달에 몰려도 지수가 튀지 않습니다. 표준오차는 단지 단위 군집 강건 분산, 수집이 완결된 달(시군구 90% 이상 반영)만 씁니다.</p><p>자체 산출 실험 지수이며 공식 통계가 아닙니다. 공개 신고 자료를 가공한 학습·포트폴리오용 데이터입니다. 공식 통계가 아니며 투자 판단 근거로 쓰지 마세요.</p></details></section><aside><div class="section-head"><h2>R-ONE 대비 검증</h2></div><div class="kpis" style="grid-template-columns: 1fr;"><div class="kpi" title="매달 변화율(%)끼리의 피어슨 상관. 1에 가까울수록 같은 방향·크기로 움직임"><div class="k">월간 변화율 상관계수</div><div class="v">0.91</div><div class="d">매우 비슷하게 움직임</div></div><div class="kpi"><div class="k">방향 일치율</div><div class="v">83%</div><div class="d">매달 오르내림 방향이 같았던 비율</div></div><div class="kpi"><div class="k">비교 기간</div><div class="v">22개월</div><div class="d">2023-02~2024-11</div></div></div><p class="note">기준: R-ONE test. 두 지수는 산식·표본이 달라 수준이 아니라 움직임을 비교합니다.</p></aside></div><section class="section"><div class="section-head"><h2>지역별 비교</h2><span class="sub">확정된 최근 달 기준 · 추이는 최근 24개월(잠정 포함)</span></div><section class="table-wrap" tabindex="0" aria-label="표"><table class="t"><thead><tr><th class=" sortable" aria-sort="ascending" scope="col"><button type="button" class="th-sort">지역<span class="arrow" aria-hidden="true">▲</span></button></th><th class=" " scope="col">기준월</th><th class="num sortable" scope="col"><button type="button" class="th-sort"><span class="arrow idle" aria-hidden="true">↕</span>지수</button></th><th class="num sortable" scope="col"><button type="button" class="th-sort"><span class="arrow idle" aria-hidden="true">↕</span>전월비</button></th><th class="num sortable" scope="col"><button type="button" class="th-sort"><span class="arrow idle" aria-hidden="true">↕</span>전년비</button></th><th class=" " scope="col">24개월</th><th class="num sortable" scope="col"><button type="button" class="th-sort"><span class="arrow idle" aria-hidden="true">↕</span>R-ONE 상관</button></th><th class="num sortable" scope="col"><button type="button" class="th-sort"><span class="arrow idle" aria-hidden="true">↕</span>방향 일치</button></th></tr></thead><tbody><tr class="clickable selected" tabindex="0"><td class=""><span class="name">전국</span></td><td class="">2024.12 </td><td class="num"><strong>123.00</strong></td><td class="num"><span class="chg up"><span aria-hidden="true">▲ +0.82%</span><span class="sr-only">상승 0.82%</span></span></td><td class="num"><span class="chg up"><span aria-hidden="true">▲ +10.81%</span><span class="sr-only">상승 10.81%</span></span></td><td class=""><svg width="96" height="26" role="img" aria-label="전국 지수 추이" style="display: block;"><path d="M0.0,23.0L4.2,22.1L8.3,21.3L12.5,20.4L16.7,19.5L20.9,18.7L25.0,17.8L29.2,16.9L33.4,16.0L37.6,15.2L41.7,14.3L45.9,13.4L50.1,12.6L54.3,11.7L58.4,10.8L62.6,10.0L66.8,9.1L71.0,8.2L75.1,7.3L79.3,6.5L83.5,5.6L87.7,4.7L91.8,3.9L96.0,3.0" fill="none" stroke="var(--series-1)" stroke-width="1.5" stroke-linejoin="round"></path><circle cx="96" cy="3" r="2.5" fill="var(--series-1)"></circle></svg></td><td class="num">0.91</td><td class="num">83%</td></tr></tbody></table><div class="table-foot"><span>행을 누르면 위 차트가 그 지역으로 바뀝니다. 거래가 적은 시도는 신뢰구간이 넓고 상관이 낮게 나올 수 있습니다.</span></div></section></section></main><footer class="footer"><div class="footer-inner">원천: 국토교통부 아파트 매매 실거래가 자료 · 행정안전부 법정동코드 · 한국부동산원 R-ONE 부동산통계 · 국토정보플랫폼 V-World 행정경계. 공개 신고 자료를 가공한 학습·포트폴리오용 서비스이며 공식 통계가 아닙니다. 투자 판단의 근거로 쓰지 마세요.<br>API 문서 <a href="/docs" target="_blank" rel="noreferrer">/docs</a> · 데이터셋 gold@test.1</div></footer>"`;

exports[`화면 특성 (서버 골든 응답으로 그린 결과) > 가격지수 > requests 1`] = `
[
  "/v1/index/summary",
  "/v1/index?regionId=00",
  "/v1/market/ticker",
  "/v1/regions",
]
`;

exports[`화면 특성 (서버 골든 응답으로 그린 결과) > 개발자 > dom 1`] = `"<header class="header"><div class="topbar"><a class="brand" href="#/market" aria-label="AptLake 아파트 실거래 데이터 · 홈"><span class="mark" aria-hidden="true"></span>AptLake<span class="sub">아파트 실거래 데이터</span></a><search class="search" role="search"><span class="glass" aria-hidden="true">⌕</span><input placeholder="시군구·단지명 검색 (예: 분당, ㅂㄷ, 래미안)" aria-label="시군구·단지 검색" role="combobox" aria-expanded="false" aria-controls="search-results" value=""></search><div class="right"><span class="meta-chip" title="데이터셋 버전 · 원천 관측 시각">gold@test.1 · 원천 –</span><button type="button" class="icon-btn theme-btn" aria-label="화면 테마: OS 설정 따름 (지금 밝게) — 누르면 어둡게" title="화면 테마: OS 설정 따름 (지금 밝게) — 누르면 어둡게"><span aria-hidden="true">◐</span><span class="theme-name">자동</span></button></div></div><nav class="nav" aria-label="메뉴"><div class="nav-inner"><a href="#/market">시장 개요</a><a href="#/region">지역 분석</a><a href="#/trades">거래 목록</a><a href="#/index">가격지수</a><a href="#/quality">데이터 품질</a><a href="#/dev" aria-current="page">개발자</a><a href="#/ops">수집 상태</a></div></nav><section class="ticker" aria-label="주요 지표" aria-busy="false"><section class="ticker-inner" tabindex="0" aria-label="시장 지표 띠 (좌우 스크롤)"><div class="tick" title="전월 대비"><span class="l">전국 거래 2024.12</span><span class="v">1,070</span><span class="chg up"><span aria-hidden="true">▲ +0.9%</span><span class="sr-only">상승 0.9%</span></span></div><div class="tick" title="전년 동월 대비"><span class="l">전국 <span class="sqm">m<sup>2</sup></span>당 중위가</span><span class="v">1,512만원/<span class="sqm">m<sup>2</sup></span></span></div><div class="tick"><span class="l">해제율</span><span class="v">4.5%</span></div><div class="tick" title="전월 대비 (확정 월)"><span class="l">전국 지수 2024.12</span><span class="v">123.0</span><span class="chg up"><span aria-hidden="true">▲ +0.82%</span><span class="sr-only">상승 0.82%</span></span></div></section></section></header><main class="container"><div class="page-head"><div><div class="crumb">개발자</div><h1>데이터 API</h1></div><div class="tools"><a class="btn primary" href="/docs" target="_blank" rel="noreferrer">OpenAPI 문서 열기 ↗</a></div></div><div class="layout"><div><section class="section"><div class="section-head"><h2>인증</h2></div><p style="margin-top: 0px;">요청 헤더에 키를 넣습니다. 키는 발급할 때 한 번만 보이고, 서버는 원문 대신 HMAC 만 저장합니다.</p><div class="code-block"><pre tabindex="0" class="code">X-API-Key: al_live_&lt;keyId 12자&gt;.&lt;secret&gt;</pre></div><p class="note">키가 없으면 anonymous 플랜(IP 기준)입니다. 한도를 넘으면 429 와 Retry-After, 모든 오류는 RFC 9457 Problem Details(code·traceId 포함). 응답 헤더 X-Dataset-Version · X-Data-As-Of 로 어떤 발행본인지 알 수 있고, 같은 버전이면 ETag 로 304 를 받습니다.</p></section><section class="section"><div class="section-head"><h2>예시</h2><span class="sub">복사해서 터미널에 붙여 넣으세요 ($APTLAKE_KEY 는 직접 설정)</span></div><div style="margin-bottom: 12px;"><div style="font-weight: 700;">시군구 월별 통계 <span class="muted small">거래·해제·<span class="sqm">m<sup>2</sup></span>당 가격 분위수 (플랜 기간 상한 적용)</span></div><div class="code-block"><pre tabindex="0" class="code">curl -s -H "X-API-Key: $APTLAKE_KEY" "http://127.0.0.1:8610/v1/regions/41135/months?from=2025-07&amp;to=2026-06"</pre><button type="button" class="btn copy">복사</button></div></div><div style="margin-bottom: 12px;"><div style="font-weight: 700;">거래 목록 (커서 페이지) <span class="muted small">응답의 page.nextCursor 를 cursor 로 넘기면 다음 페이지. 서명된 값이라 조건을 바꾸면 400</span></div><div class="code-block"><pre tabindex="0" class="code">curl -s -H "X-API-Key: $APTLAKE_KEY" "http://127.0.0.1:8610/v1/trades?sggCd=41135&amp;from=2026-06-01&amp;to=2026-06-30&amp;limit=200"</pre><button type="button" class="btn copy">복사</button></div></div><div style="margin-bottom: 12px;"><div style="font-weight: 700;">거래 버전 이력 <span class="muted small">해제·등기일 등 원천 값이 바뀐 기록 (SCD2)</span></div><div class="code-block"><pre tabindex="0" class="code">curl -s -H "X-API-Key: $APTLAKE_KEY" "http://127.0.0.1:8610/v1/trades/{tradeId}/history"</pre><button type="button" class="btn copy">복사</button></div></div><div style="margin-bottom: 12px;"><div style="font-weight: 700;">시장 개요 <span class="muted small">전국·시도·시군구 한 달 요약과 순위</span></div><div class="code-block"><pre tabindex="0" class="code">curl -s -H "X-API-Key: $APTLAKE_KEY" "http://127.0.0.1:8610/v1/market/overview?ym=2026-06"</pre><button type="button" class="btn copy">복사</button></div></div><div style="margin-bottom: 12px;"><div style="font-weight: 700;">자체 지수 + 검증 <span class="muted small">HEDONIC_TD_v1 시계열, R-ONE 대비 상관·방향 일치율</span></div><div class="code-block"><pre tabindex="0" class="code">curl -s -H "X-API-Key: $APTLAKE_KEY" "http://127.0.0.1:8610/v1/index?regionId=11"</pre><button type="button" class="btn copy">복사</button></div></div><div style="margin-bottom: 12px;"><div style="font-weight: 700;">파티션 품질·계보 <span class="muted small">검사 결과, 원본 XML 경로, Iceberg 스냅샷, 발행 버전</span></div><div class="code-block"><pre tabindex="0" class="code">curl -s -H "X-API-Key: $APTLAKE_KEY" "http://127.0.0.1:8610/v1/quality/partitions/41135/2026-06"</pre><button type="button" class="btn copy">복사</button></div></div></section></div><aside><section class="section"><div class="section-head"><h2>플랜</h2></div><section class="table-wrap" tabindex="0" aria-label="표"><table class="t"><thead><tr><th class=" " scope="col">플랜</th><th class="num " scope="col">분당</th><th class="num " scope="col">일일 행</th><th class=" " scope="col">기간</th></tr></thead><tbody><tr class=" "><td class=""><span class="name">anonymous<span class="sub">키 없음 · IP 당</span></span></td><td class="num">20</td><td class="num">5,000</td><td class="">12개월</td></tr><tr class=" "><td class=""><span class="name">free<span class="sub">발급 키</span></span></td><td class="num">60</td><td class="num">50,000</td><td class="">24개월</td></tr><tr class=" "><td class=""><span class="name">pro<span class="sub">발급 키</span></span></td><td class="num">600</td><td class="num">2,000,000</td><td class="">전체</td></tr><tr class=" "><td class=""><span class="name">web<span class="sub">이 웹 화면 · 브라우저 IP 당</span></span></td><td class="num">300</td><td class="num">200,000</td><td class="">60개월</td></tr></tbody></table></section><p class="note">일일 '행' 한도는 거래 단위 레코드(거래 목록·이력·산점도)에만 적용되고, 집계 응답(월별 통계·지도·순위)은 요청 수 한도만 받습니다. 웹 화면은 BFF 방식으로, 브라우저에는 키가 없고 웹 서버가 서버 쪽 키를 붙입니다.</p></section><section class="section"><div class="section-head"><h2>내 키 사용량</h2></div><div class="toolbar"><input class="text-input" style="flex: 1 1 0%; min-width: 180px;" autocomplete="off" placeholder="al_live_…" aria-label="API 키 (메모리에만 보관)" type="password" value=""><button type="button" class="btn primary" disabled="">조회</button></div><p class="note">키는 이 화면 메모리에만 있고 저장하지 않습니다.</p></section></aside></div></main><footer class="footer"><div class="footer-inner">원천: 국토교통부 아파트 매매 실거래가 자료 · 행정안전부 법정동코드 · 한국부동산원 R-ONE 부동산통계 · 국토정보플랫폼 V-World 행정경계. 공개 신고 자료를 가공한 학습·포트폴리오용 서비스이며 공식 통계가 아닙니다. 투자 판단의 근거로 쓰지 마세요.<br>API 문서 <a href="/docs" target="_blank" rel="noreferrer">/docs</a> · 데이터셋 gold@test.1</div></footer>"`;

exports[`화면 특성 (서버 골든 응답으로 그린 결과) > 개발자 > requests 1`] = `
[
  "/v1/market/ticker",
  "/v1/regions",
]
`;

exports[`화면 특성 (서버 골든 응답으로 그린 결과) > 거래 목록 > dom 1`] = `"<header class="header"><div class="topbar"><a class="brand" href="#/market" aria-label="AptLake 아파트 실거래 데이터 · 홈"><span class="mark" aria-hidden="true"></span>AptLake<span class="sub">아파트 실거래 데이터</span></a><search class="search" role="search"><span class="glass" aria-hidden="true">⌕</span><input placeholder="시군구·단지명 검색 (예: 분당, ㅂㄷ, 래미안)" aria-label="시군구·단지 검색" role="combobox" aria-expanded="false" aria-controls="search-results" value=""></search><div class="right"><span class="meta-chip" title="데이터셋 버전 · 원천 관측 시각">gold@test.1 · 원천 –</span><button type="button" class="icon-btn theme-btn" aria-label="화면 테마: OS 설정 따름 (지금 밝게) — 누르면 어둡게" title="화면 테마: OS 설정 따름 (지금 밝게) — 누르면 어둡게"><span aria-hidden="true">◐</span><span class="theme-name">자동</span></button></div></div><nav class="nav" aria-label="메뉴"><div class="nav-inner"><a href="#/market">시장 개요</a><a href="#/region">지역 분석</a><a href="#/trades" aria-current="page">거래 목록</a><a href="#/index">가격지수</a><a href="#/quality">데이터 품질</a><a href="#/dev">개발자</a><a href="#/ops">수집 상태</a></div></nav><section class="ticker" aria-label="주요 지표" aria-busy="false"><section class="ticker-inner" tabindex="0" aria-label="시장 지표 띠 (좌우 스크롤)"><div class="tick" title="전월 대비"><span class="l">전국 거래 2024.12</span><span class="v">1,070</span><span class="chg up"><span aria-hidden="true">▲ +0.9%</span><span class="sr-only">상승 0.9%</span></span></div><div class="tick" title="전년 동월 대비"><span class="l">전국 <span class="sqm">m<sup>2</sup></span>당 중위가</span><span class="v">1,512만원/<span class="sqm">m<sup>2</sup></span></span></div><div class="tick"><span class="l">해제율</span><span class="v">4.5%</span></div><div class="tick" title="전월 대비 (확정 월)"><span class="l">전국 지수 2024.12</span><span class="v">123.0</span><span class="chg up"><span aria-hidden="true">▲ +0.82%</span><span class="sr-only">상승 0.82%</span></span></div></section></section></header><main class="container"><div class="page-head"><div><div class="crumb">거래 목록 · 경기도</div><h1>성남시 분당구 매매 거래</h1></div></div><div class="toolbar"><div class="pop-anchor region-picker"><button type="button" class="btn" aria-haspopup="dialog" aria-expanded="false" style="min-width: 200px; justify-content: space-between;"><span><span class="muted">경기도 · </span>성남시 분당구</span><span class="caret">▼</span></button></div><div class="pop-anchor"><button type="button" class="btn" aria-haspopup="dialog" aria-expanded="false">📅 2024.07.01 – 2024.07.31 <span class="caret">▼</span></button></div><fieldset class="group chips"><legend class="sr-only">전용면적</legend><button type="button" class="chip" aria-pressed="true">전체</button><button type="button" class="chip" aria-pressed="false">40<span class="sqm">m<sup>2</sup></span> 미만</button><button type="button" class="chip" aria-pressed="false">40~60<span class="sqm">m<sup>2</sup></span></button><button type="button" class="chip" aria-pressed="false">60~85<span class="sqm">m<sup>2</sup></span></button><button type="button" class="chip" aria-pressed="false">85~135<span class="sqm">m<sup>2</sup></span></button><button type="button" class="chip" aria-pressed="false">135<span class="sqm">m<sup>2</sup></span> 이상</button></fieldset><label class="switch"><input role="switch" aria-checked="true" type="checkbox" checked="">해제 거래 포함</label></div><div class="kpis" aria-busy="false"><div class="kpi"><div class="k">조회 조건 전체</div><div class="v">250<small>건</small></div><div class="d">이 중 해제 25건</div></div><div class="kpi"><div class="k"><span class="sqm">m<sup>2</sup></span>당 중위가</div><div class="v">1,177<small>만원/<span class="sqm">m<sup>2</sup></span></small></div><div class="d">해제·이상치 제외</div></div><div class="kpi"><div class="k">중위 거래가</div><div class="v">10억 125만<small>원</small></div><div class="d">해제 제외</div></div></div><div class=""><div><section class="table-wrap" tabindex="0" aria-label="표"><table class="t"><thead><tr><th class=" sortable" scope="col"><button type="button" class="th-sort">계약일<span class="a