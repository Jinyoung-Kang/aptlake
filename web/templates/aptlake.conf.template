# 정적 SPA + 공개 API 프록시 (관리 API 는 프록시하지 않는다)
# 웹 화면은 BFF: 브라우저에는 키가 없고, 여기서 서버 쪽 웹 전용 키를 붙인다 (한도는 API 가 브라우저 IP 단위로 적용).
# 사용자가 직접 키를 넣은 요청(개발자 화면)은 그 키를 그대로 전달한다.
map $http_x_api_key $aptlake_api_key {
    ""      "${WEB_API_KEY}";
    default $http_x_api_key;
}

server {
    listen 8080;
    client_max_body_size 16k;
    root /usr/share/nginx/html;

    # api 컨테이너가 재생성돼 IP 가 바뀌어도 따라가도록 도커 DNS 로 매번(10초 캐시) 다시 해석
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://api:8610;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;

    location /v1/admin { return 404; }

    location ~ ^/(v1/|openapi\.json$) {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        # 클라이언트가 보낸 X-Forwarded-For 는 버리고 실제 접속 주소로 덮어쓴다
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Request-Id $request_id;
        proxy_set_header X-API-Key $aptlake_api_key;
        proxy_read_timeout 30s;
    }

    location = /docs {
        proxy_pass $api_upstream;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Swagger UI 는 jsdelivr 의 스크립트를 쓰므로 이 경로만 CSP 를 API 가 정한 값으로 둔다
        proxy_hide_header Content-Security-Policy;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; frame-ancestors 'none'" always;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" always;
    }
}
