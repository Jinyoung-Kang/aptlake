<!--
  서비스별 ClickHouse 사용자 (기획서 9장 '서빙 DB').
    publisher     : Dagster 발행 전용 (스테이징 적재 + 파티션 교체)
    api_reader    : API 조회 전용. readonly=1, 쿼리 시간·메모리·결과 행 상한
    usage_writer  : API 사용량 이벤트 INSERT 전용 (usage_event 한 테이블)
    exporter      : 대량 내려받기 전용. trade_current SELECT 만, 결과 행 상한 없음(시간·메모리 상한은 있음)
  비밀번호는 컨테이너 환경변수에서 읽는다 (파일·이미지에 비밀 없음).
-->
<clickhouse>
    <profiles>
        <api_readonly>
            <readonly>1</readonly>
            <max_execution_time>5</max_execution_time>
            <max_memory_usage>300000000</max_memory_usage>
            <max_result_rows>200000</max_result_rows>
            <result_overflow_mode>throw</result_overflow_mode>
            <max_threads>2</max_threads>
        </api_readonly>
        <writer>
            <max_memory_usage>300000000</max_memory_usage>
            <max_execution_time>30</max_execution_time>
        </writer>
        <exporter>
            <readonly>1</readonly>
            <max_execution_time>120</max_execution_time>
            <max_memory_usage>400000000</max_memory_usage>
            <max_threads>2</max_threads>
            <!-- 전체 정렬(ORDER BY deal_date, trade_id)이 메모리 상한에 닿기 전에 디스크로 나눠 정렬한다 —
                 없으면 거래가 늘수록 내보낼 수 있는 기간이 줄다가 전체 기간이 MEMORY_LIMIT_EXCEEDED (QA-006).
                 26.8 은 비율 설정(기본 0.5)이 있으면 바이트 값이 쓰이지 않아 비율을 끈다. 270만 행: 최대 216MB · 3.9초 -->
            <max_bytes_before_external_sort>150000000</max_bytes_before_external_sort>
            <max_bytes_ratio_before_external_sort>0</max_bytes_ratio_before_external_sort>
        </exporter>
        <publisher>
            <max_memory_usage>800000000</max_memory_usage>
            <max_execution_time>600</max_execution_time>
        </publisher>
    </profiles>
    <users>
        <default remove="remove"/>
        <publisher>
            <password from_env="CLICKHOUSE_PUBLISHER_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>publisher</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT, INSERT, ALTER, CREATE TABLE, DROP TABLE, TRUNCATE ON aptlake.*</query>
            </grants>
        </publisher>
        <api_reader>
            <password from_env="CLICKHOUSE_READER_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>api_readonly</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON aptlake.*</query>
                <!-- 연결 점검 화면의 '서빙 DB 메모리 사용 / 상한' 표시용 — 두 시스템 표의 두 열만 -->
                <query>GRANT SELECT(metric, value) ON system.metrics</query>
                <query>GRANT SELECT(name, value) ON system.server_settings</query>
            </grants>
        </api_reader>
        <exporter>
            <password from_env="CLICKHOUSE_EXPORT_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>exporter</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON aptlake.trade_current</query>
            </grants>
        </exporter>
        <usage_writer>
            <password from_env="CLICKHOUSE_USAGE_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>writer</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT INSERT ON aptlake.usage_event</query>
            </grants>
        </usage_writer>
    </users>
</clickhouse>
