# .env.example — 집값 레이크하우스 (AptLake) (값은 비워 둔 채 커밋)
#   cp .env.example .env 후 값을 채우세요. `make init` 은 .env 가 없으면 만들고,
#   비어 있는 내부 비밀번호·pepper 를 무작위 값으로 채웁니다.
#   값 뒤에 줄 끝 주석을 달지 마세요 (docker compose 가 값으로 읽습니다).

# ---- 외부 API 키 (파이프라인 컨테이너에서만 사용, 브라우저·API 서버에 전달하지 않음) ----
# 공공데이터포털 일반 인증키 (Decoding 키) — 국토교통부 아파트 매매 실거래가 자료, 행정안전부 법정동코드
DATA_GO_KR_KEY=
# 한국부동산원 R-ONE 부동산통계 Open API 인증키 (KEY) — 자체 지수 검증용
REB_API_KEY=

# ---- 수집 파라미터 ----
# 공공데이터포털 개발계정 일일 한도와 그중 사용 상한 비율(%)
RTMS_DAILY_LIMIT=10000
RTMS_BUDGET_PCT=80
# 백필 시작 계약월 (YYYY-MM). 조회 가능 범위는 tools/probe_rtms.py 로 측정
BACKFILL_FROM=2021-01

# ---- 내부 자격증명 (make init 이 비어 있는 값을 무작위로 채움) ----
POSTGRES_PASSWORD=
LAKEKEEPER_DB_PASSWORD=
LAKEKEEPER_ENCRYPTION_KEY=
DAGSTER_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=
PIPELINE_DB_PASSWORD=
API_DB_PASSWORD=
MINIO_ROOT_PASSWORD=
MINIO_INGEST_SECRET=
MINIO_CATALOG_SECRET=
MINIO_EXPORT_SECRET=
CLICKHOUSE_ADMIN_PASSWORD=
CLICKHOUSE_PUBLISHER_PASSWORD=
CLICKHOUSE_READER_PASSWORD=
CLICKHOUSE_USAGE_PASSWORD=
CLICKHOUSE_EXPORT_PASSWORD=
REDIS_API_PASSWORD=
REDIS_PIPELINE_PASSWORD=
# API 키 HMAC pepper · 커서 서명 키 (32바이트 이상)
API_KEY_PEPPER=
CURSOR_SIGNING_KEY=
GRAFANA_ADMIN_PASSWORD=
